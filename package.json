{
  "name": "eslint-plugin-template-security",
  "version": "0.1.0",
  "description": "ESLint security rules for template bindings, written once for JSX, Astro, Vue, Svelte and HTML: unsafe HTML sinks, script breakout, javascript: URLs, mixed content, SRI, iframe sandbox escapes and missing noopener.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "security",
    "xss",
    "templates",
    "vue",
    "react",
    "jsx",
    "astro",
    "solid",
    "v-html",
    "dangerouslySetInnerHTML",
    "noopener",
    "target-blank",
    "javascript-url",
    "sri",
    "subresource-integrity",
    "mixed-content",
    "iframe",
    "sandbox",
    "json-ld",
    "svelte",
    "sveltekit",
    "@html",
    "html",
    "handlebars"
  ],
  "license": "MIT",
  "author": "rsmple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsmple/eslint-plugin-template-security.git"
  },
  "bugs": {
    "url": "https://github.com/rsmple/eslint-plugin-template-security/issues"
  },
  "homepage": "https://github.com/rsmple/eslint-plugin-template-security#readme",
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@html-eslint/parser": "0.66.1",
    "astro-eslint-parser": "3.1.0",
    "eslint": "10.10.0",
    "svelte": "5.57.0",
    "svelte-eslint-parser": "1.8.1",
    "vue-eslint-parser": "10.4.1"
  }
}
